  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4fd76e3eef5014ab78715325e745ee5c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialScheduler
  tutorialSegments:
  - schedule: {fileID: 11400000, guid: 7e9e510e6e10c49f59f7520f76a709b9, type: 2}
    text: 'Welcome to our Rythm Game!


      Please calibrate yourself by putting
      your arms at your sides and pressing the trigger button on your controller.'
    gameObjects:
    - {fileID: 2000081747}
    requiredPoints: 0
    useBool: 1
    boolValue: {fileID: 1029750899}
    bufferBeats: 2
  - schedule: {fileID: 11400000, guid: 43b84850979744b8693d9c51cc2f85c4, type: 2}
    text: 'In this game, your goal is to hit the targets on time.


      Try to
      hit this target with your left hand when the circle closes around it.'
    gameObjects: []
    requiredPoints: 1
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 4
  - schedule: {fileID: 11400000, guid: 7af2f5476d0114c9dbca24dda277f8e2, type: 2}
    text: "Nice! \n\nNow try with both your left and right hands."
    gameObjects: []
    requiredPoints: 2
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 4
  - schedule: {fileID: 11400000, guid: 1832b9f60753747a3b38228ad33ea5d6, type: 2}
    text: 'Great! Try hitting these four targets on time!


      Targets with more
      rings give you more points. '
    gameObjects: []
    requiredPoints: 4
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 4
  - schedule: {fileID: 11400000, guid: b93a2b52e338e47729d93fb95ec3196a, type: 2}
    text: 'Try to dodge this obstacle!


      If it hits you, you will lose points.'
    gameObjects: []
    requiredPoints: 0
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 8
  - schedule: {fileID: 11400000, guid: 1028ded3bc13a42c695e71042c0b8ce2, type: 2}
    text: 'Obstacles with rings can be hit. Use your controller to hit this obstacle
      away!


      Hitting obstacles away will give you points!'
    gameObjects: []
    requiredPoints: 1
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 8
  - schedule: {fileID: 11400000, guid: 6e17445fa9dae43eab8e203bd4a7ae12, type: 2}
    text: Awesome! You're ready to play!
    gameObjects: []
    requiredPoints: 0
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 8
  _text: {fileID: 509820150}
