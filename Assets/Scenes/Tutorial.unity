--- !u!114 &1602856251
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1602856250}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4fd76e3eef5014ab78715325e745ee5c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialScheduler
  tutorialSegments:
  - schedule: {fileID: 11400000, guid: 7e9e510e6e10c49f59f7520f76a709b9, type: 2}
    text: 'Welcome to our Rhythm Game!


      Please calibrate yourself by putting
      your arms at your sides and pressing A on your controller.


      You can
      press B at any time to restart the game.'
    gameObjects:
    - {fileID: 2000081747}
    requiredPoints: 0
    useBool: 1
    boolValue: {fileID: 1029750899}
    bufferBeats: 2
  - schedule: {fileID: 11400000, guid: 43b84850979744b8693d9c51cc2f85c4, type: 2}
    text: 'In this game, your goal is to TOUCH the targets with your hands on the
      BEAT.


      Try to TOUCH this target with your LEFT HAND.'
    gameObjects: []
    requiredPoints: 1
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 6
  - schedule: {fileID: 11400000, guid: 7af2f5476d0114c9dbca24dda277f8e2, type: 2}
    text: "Nice! \n\nTouch PINK targets with your LEFT HAND.\n\nTouch BLUE targets
      with your RIGHT HAND. "
    gameObjects: []
    requiredPoints: 2
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 6
  - schedule: {fileID: 11400000, guid: 1832b9f60753747a3b38228ad33ea5d6, type: 2}
    text: "Great! \nTry touching these three targets ON BEAT when the RINGS close
      around them!\n\nTargets with more RINGS give you more POINTS. "
    gameObjects: []
    requiredPoints: 3
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 6
  - schedule: {fileID: 11400000, guid: b93a2b52e338e47729d93fb95ec3196a, type: 2}
    text: 'Try to DODGE this obstacle!


      If it hits you, you will lose points.'
    gameObjects: []
    requiredPoints: 0
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 6
  - schedule: {fileID: 11400000, guid: 1028ded3bc13a42c695e71042c0b8ce2, type: 2}
    text: Obstacles with RED RINGS can be PUNCHED with your HAND. Try to PUNCH this
      obstacle away!
    gameObjects: []
    requiredPoints: 0
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 6
  - schedule: {fileID: 11400000, guid: 6e17445fa9dae43eab8e203bd4a7ae12, type: 2}
    text: 'Awesome! You''re ready to play!


      You can press B at any time to
      restart the game.'
    gameObjects: []
    requiredPoints: 0
    useBool: 0
    boolValue: {fileID: 0}
    bufferBeats: 8
  _text: {fileID: 509820150}
